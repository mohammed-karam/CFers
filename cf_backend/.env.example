# Database
DATABASE_URL=sqlite+aiosqlite:///./cf_backend.db
# For PostgreSQL (production on Railway):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/cf_db

# Security
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Firebase Cloud Messaging (optional - for push notifications)
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# -----------------------------------------------------------------
# Email / SMTP Settings
# -----------------------------------------------------------------
# For Gmail:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification
#   3. Search "App Passwords", generate one for "Mail"
#   4. Use that 16-character password below
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-gmail@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx   <-- your App Password
# SMTP_FROM_EMAIL=your-gmail@gmail.com
#
# For SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=SG.your-sendgrid-api-key
# SMTP_FROM_EMAIL=noreply@yourdomain.com
# -----------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@example.com

# Codeforces
CODEFORCES_BASE_URL=https://codeforces.com/api
